<Window x:Class="VNotch.Windows.AppDrawerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinn App Drawer"
        Width="460"
        Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Soft Drop Shadow for the Card -->
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="36" Color="#000000" Opacity="0.48" ShadowDepth="6" Direction="270"/>
        <DropShadowEffect x:Key="MiniIconShadow" BlurRadius="6" Color="#000000" Opacity="0.25" ShadowDepth="1" Direction="270"/>

        <!-- Base Button / Squircle Styles -->
        <Style x:Key="GlassIconButton" TargetType="Button">
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#40FFFFFF"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#60FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootContainer" Margin="16" AllowDrop="True" Drop="RootContainer_Drop" DragOver="RootContainer_DragOver">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="0"/>
        </Grid.RenderTransform>

        <!-- Main Glass Window Border -->
        <Border x:Name="GlassBorder"
                CornerRadius="24"
                BorderBrush="#38FFFFFF"
                BorderThickness="1.2"
                Effect="{StaticResource WindowShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F41C1C24" Offset="0.0"/>
                    <GradientStop Color="#EC171720" Offset="0.5"/>
                    <GradientStop Color="#E6101016" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="18,16,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Content (Folders or Apps) -->
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <!-- State A: Main Drawer Header -->
                    <Grid x:Name="MainHeaderGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title + Icon -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="8" Background="#35FFFFFF" Margin="0,0,10,0">
                                <UniformGrid Rows="2" Columns="2" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="4.5" Height="4.5" CornerRadius="1.5" Background="#FFFFFF" Margin="1"/>
                                    <Border Width="4.5" Height="4.5" CornerRadius="1.5" Background="#FFFFFF" Margin="1"/>
                                    <Border Width="4.5" Height="4.5" CornerRadius="1.5" Background="#FFFFFF" Margin="1"/>
                                    <Border Width="4.5" Height="4.5" CornerRadius="1.5" Background="#FFFFFF" Margin="1"/>
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="App Library" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Search Box -->
                        <Border Grid.Column="1" Margin="14,0,10,0" Height="30" CornerRadius="15" Background="#1FFFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                            <Grid Margin="10,0,10,0">
                                <TextBlock x:Name="SearchPlaceholder" Text="Cari aplikasi..." FontSize="12" Foreground="#88FFFFFF" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="SearchTextBox" Background="Transparent" Foreground="#FFFFFFFF" BorderThickness="0" FontSize="12" VerticalAlignment="Center" TextChanged="SearchTextBox_TextChanged"/>
                            </Grid>
                        </Border>

                        <!-- Add Folder Button -->
                        <Button Grid.Column="2" Style="{StaticResource GlassIconButton}" Width="30" Height="30" Click="AddFolder_Click" ToolTip="Tambah Folder Baru">
                            <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,-2,0,0"/>
                        </Button>
                    </Grid>

                    <!-- State B: Expanded Folder Header -->
                    <Grid x:Name="FolderHeaderGrid" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Back Button -->
                        <Button Grid.Column="0" Style="{StaticResource GlassIconButton}" Height="30" Padding="10,0" Click="BackToFolders_Click" ToolTip="Kembali ke Daftar Folder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="‹" FontSize="18" FontWeight="Bold" Margin="0,-3,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Folder" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Active Folder Title -->
                        <TextBlock x:Name="ActiveFolderTitle" Grid.Column="1" Text="Folder Name" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Add App to Folder Button -->
                        <Button Grid.Column="2" Style="{StaticResource GlassIconButton}" Height="30" Padding="10,0" Click="AddApp_Click" ToolTip="Tambah Aplikasi ke Folder Ini">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontSize="15" FontWeight="Bold" Margin="0,-2,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="App" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- CONTENT AREA -->
                <!-- 1. Folder Grid View -->
                <ScrollViewer x:Name="FolderScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="FoldersPanel" HorizontalAlignment="Center" Orientation="Horizontal"/>
                </ScrollViewer>

                <!-- 2. Folder Expanded Apps View -->
                <ScrollViewer x:Name="AppsScrollViewer" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Klik aplikasi untuk membuka • Seret file .exe / shortcut ke sini" FontSize="11" Foreground="#66FFFFFF" Margin="4,0,0,10" HorizontalAlignment="Center"/>
                        <WrapPanel x:Name="AppsPanel" HorizontalAlignment="Center" Orientation="Horizontal"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Search Results View -->
                <ScrollViewer x:Name="SearchResultsScrollViewer" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="SearchResultsPanel" HorizontalAlignment="Center" Orientation="Horizontal"/>
                </ScrollViewer>

            </Grid>
        </Border>
    </Grid>
</Window>
