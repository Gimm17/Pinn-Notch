<Window x:Class="VNotch.Windows.AppMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fonts="clr-namespace:VNotch.Services"
        Title="Pinn-Notch Resource Monitor"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="{fonts:AppFont Fallbacks='Nirmala UI, Segoe UI'}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Dropshadow for card -->
        <DropShadowEffect x:Key="WindowCardShadow" BlurRadius="32" Color="#000000" Opacity="0.55" ShadowDepth="4" Direction="270"/>
        <DropShadowEffect x:Key="MiniPillShadow" BlurRadius="16" Color="#000000" Opacity="0.45" ShadowDepth="2" Direction="270"/>

        <!-- Control button style -->
        <Style x:Key="HeaderActionBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBrd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBrd" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <!-- 1. FULL CARD VIEW -->
        <Border x:Name="FullCardPanel"
                CornerRadius="20"
                BorderBrush="#30FFFFFF"
                BorderThickness="1.2"
                Effect="{StaticResource WindowCardShadow}"
                Padding="16,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F2121318" Offset="0.0"/>
                    <GradientStop Color="#E60D0E12" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel Orientation="Vertical">
                <!-- Header -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Dot & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#30D158" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" Color="#30D158" Opacity="0.8" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="Pinn-Notch" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border Background="#2064D2FF" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Monitor" FontSize="10" FontWeight="Bold" Foreground="#64D2FF"/>
                        </Border>
                    </StackPanel>

                    <!-- Window Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Compact Mode Toggle -->
                        <Button x:Name="BtnCompact" Style="{StaticResource HeaderActionBtn}" ToolTip="Mode Ringkas / Compact" Click="BtnCompact_Click" Margin="0,0,2,0">
                            <Path Data="M3 3h18v2H3V3zm4 6h10v2H7V9zm-4 6h18v2H3v-2z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="11" Height="11"/>
                        </Button>
                        <!-- Topmost Pin Toggle -->
                        <Button x:Name="BtnPin" Style="{StaticResource HeaderActionBtn}" ToolTip="Selalu di Atas / Always on Top" Click="BtnPin_Click" Margin="0,0,2,0">
                            <Path x:Name="PinIconPath" Data="M12 2l2 2v5l3 3v2h-6v6l-1 1-1-1v-6H3v-2l3-3V4l2-2h4z" Fill="#64D2FF" Stretch="Uniform" Width="11" Height="11"/>
                        </Button>
                        <!-- Close Button -->
                        <Button Style="{StaticResource HeaderActionBtn}" ToolTip="Tutup" Click="BtnClose_Click">
                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="11" Height="11"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- CARD 1: CPU USAGE -->
                <Border Background="#15FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CPU" FontSize="12" FontWeight="Bold" Foreground="#64D2FF" VerticalAlignment="Center"/>
                                <TextBlock Text=" (App Total)" FontSize="10.5" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="CpuValueText" Text="0.0%" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Progress Bar -->
                        <Border Height="5" CornerRadius="2.5" Background="#20FFFFFF" Margin="0,8,0,8" ClipToBounds="True">
                            <Border x:Name="CpuBar" HorizontalAlignment="Left" Width="0" Height="5" CornerRadius="2.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#64D2FF" Offset="0.0"/>
                                        <GradientStop Color="#0A84FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>

                        <!-- Sub-details Chips -->
                        <WrapPanel Orientation="Horizontal">
                            <Border Background="#1A64D2FF" CornerRadius="4" Padding="6,2" Margin="0,0,6,2">
                                <TextBlock x:Name="CpuMainProcText" Text="Pinn-Notch: 0.0%" FontSize="10" Foreground="#B0D8FF"/>
                            </Border>
                            <Border x:Name="CpuWebViewBadge" Background="#1ABF5AF2" CornerRadius="4" Padding="6,2" Margin="0,0,6,2" Visibility="Collapsed">
                                <TextBlock x:Name="CpuWebViewText" Text="YTM Web: 0.0%" FontSize="10" Foreground="#E0B0FF"/>
                            </Border>
                            <Border Background="#12FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,0,2">
                                <TextBlock x:Name="CpuSystemText" Text="System: 0.0%" FontSize="10" Foreground="#A0A0AA"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 2: GPU USAGE -->
                <Border Background="#15FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎮" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="GPU" FontSize="12" FontWeight="Bold" Foreground="#BF5AF2" VerticalAlignment="Center"/>
                                <TextBlock Text=" (App Engine)" FontSize="10.5" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="GpuValueText" Text="0.0%" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Progress Bar -->
                        <Border Height="5" CornerRadius="2.5" Background="#20FFFFFF" Margin="0,8,0,8" ClipToBounds="True">
                            <Border x:Name="GpuBar" HorizontalAlignment="Left" Width="0" Height="5" CornerRadius="2.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#BF5AF2" Offset="0.0"/>
                                        <GradientStop Color="#FF375F" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>

                        <!-- Sub-details Chips -->
                        <WrapPanel Orientation="Horizontal">
                            <Border Background="#1ABF5AF2" CornerRadius="4" Padding="6,2" Margin="0,0,6,2">
                                <TextBlock x:Name="GpuNameText" Text="Adapter: GPU" FontSize="10" Foreground="#E0B0FF" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Border Background="#12FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,0,2">
                                <TextBlock x:Name="GpuSystemText" Text="System: 0.0%" FontSize="10" Foreground="#A0A0AA"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 3: RAM USAGE -->
                <Border Background="#15FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💾" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="RAM" FontSize="12" FontWeight="Bold" Foreground="#30D158" VerticalAlignment="Center"/>
                                <TextBlock Text=" (App Total)" FontSize="10.5" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="TrimRamButton"
                                        Click="TrimRamButton_Click"
                                        ToolTip="Bersihkan &amp; Optimalkan RAM Sekarang"
                                        Background="#1A30D158"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Padding="6,2"
                                        Margin="0,0,8,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⚡" FontSize="10" Foreground="#30D158" Margin="0,0,3,0"/>
                                                    <TextBlock Text="Trim" FontSize="10" FontWeight="SemiBold" Foreground="#30D158"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock x:Name="RamValueText" Text="0.0 MB" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Progress Bar (Based on 512MB reference scale) -->
                        <Border Height="5" CornerRadius="2.5" Background="#20FFFFFF" Margin="0,8,0,8" ClipToBounds="True">
                            <Border x:Name="RamBar" HorizontalAlignment="Left" Width="0" Height="5" CornerRadius="2.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#30D158" Offset="0.0"/>
                                        <GradientStop Color="#34C759" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>

                        <!-- Sub-details Chips -->
                        <WrapPanel Orientation="Horizontal">
                            <Border Background="#1A30D158" CornerRadius="4" Padding="6,2" Margin="0,0,6,2">
                                <TextBlock x:Name="RamMainProcText" Text="Pinn-Notch: 0.0 MB" FontSize="10" Foreground="#A0FFB8"/>
                            </Border>
                            <Border x:Name="RamWebViewBadge" Background="#1ABF5AF2" CornerRadius="4" Padding="6,2" Margin="0,0,6,2" Visibility="Collapsed">
                                <TextBlock x:Name="RamWebViewText" Text="YTM Web: 0.0 MB" FontSize="10" Foreground="#E0B0FF"/>
                            </Border>
                            <Border Background="#12FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,0,2">
                                <TextBlock x:Name="RamSystemText" Text="Sys: 0.0/0.0 GB (0%)" FontSize="10" Foreground="#A0A0AA"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Process Diagnostics Footer -->
                <Grid Margin="2,0,2,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ProcSummaryText" Text="Threads: 0 • Handles: 0 • Heap: 0 MB" FontSize="10" Foreground="#70FFFFFF"/>
                    </StackPanel>
                    <TextBlock Text="● Live 1s" HorizontalAlignment="Right" FontSize="10" Foreground="#50FFFFFF" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2. MINI COMPACT PILL VIEW -->
        <Border x:Name="CompactPillPanel"
                Visibility="Collapsed"
                CornerRadius="16"
                BorderBrush="#35FFFFFF"
                BorderThickness="1"
                Effect="{StaticResource MiniPillShadow}"
                Padding="12,6"
                HorizontalAlignment="Center">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F4121318" Offset="0.0"/>
                    <GradientStop Color="#E60D0E12" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Status Dot -->
                <Ellipse Width="6" Height="6" Fill="#30D158" Margin="0,0,8,0" VerticalAlignment="Center"/>

                <!-- Compact CPU -->
                <TextBlock Text="CPU " FontSize="10.5" FontWeight="Bold" Foreground="#64D2FF" VerticalAlignment="Center"/>
                <TextBlock x:Name="CompactCpuText" Text="0.0%" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <!-- Compact GPU -->
                <TextBlock Text="GPU " FontSize="10.5" FontWeight="Bold" Foreground="#BF5AF2" VerticalAlignment="Center"/>
                <TextBlock x:Name="CompactGpuText" Text="0.0%" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <!-- Compact RAM -->
                <TextBlock Text="RAM " FontSize="10.5" FontWeight="Bold" Foreground="#30D158" VerticalAlignment="Center"/>
                <TextBlock x:Name="CompactRamText" Text="0 MB" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <!-- Expand Button -->
                <Button Style="{StaticResource HeaderActionBtn}" Width="20" Height="20" ToolTip="Tampilkan Penuh" Click="BtnExpand_Click" Margin="0,0,2,0">
                    <Path Data="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z" Fill="#B0FFFFFF" Stretch="Uniform" Width="9" Height="9"/>
                </Button>

                <!-- Close Button -->
                <Button Style="{StaticResource HeaderActionBtn}" Width="20" Height="20" ToolTip="Tutup" Click="BtnClose_Click">
                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Fill="#B0FFFFFF" Stretch="Uniform" Width="9" Height="9"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
