<Window x:Class="VNotch.Windows.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pinn-Dock"
        Height="136"
        FontFamily="{StaticResource SFProDisplay}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Width"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Adaptive Liquid Glass Brushes (swapped smoothly by backdrop luminance) -->
        <SolidColorBrush x:Key="DockPrimaryForegroundBrush" Color="#EB14171F"/>
        <SolidColorBrush x:Key="DockSecondaryForegroundBrush" Color="#A81E2430"/>
        <SolidColorBrush x:Key="DockIconForegroundBrush" Color="#D8161A24"/>
        <SolidColorBrush x:Key="DockNetArrowBrush" Color="#0284C7"/>
        <SolidColorBrush x:Key="DockWidgetHoverBrush" Color="#1C000000"/>
        <SolidColorBrush x:Key="DockDividerCenterBrush" Color="#26000000"/>
        <SolidColorBrush x:Key="DockSubDividerCenterBrush" Color="#1C000000"/>
        <SolidColorBrush x:Key="DockLauncherDotBrush" Color="#D81E2330"/>
        <SolidColorBrush x:Key="DockLauncherBorderBrush" Color="#80FFFFFF"/>

        <!-- Soft Ambient Floating Shadow -->
        <DropShadowEffect x:Key="DockShadow" BlurRadius="28" Color="#000000" Opacity="0.32" ShadowDepth="5" Direction="270"/>
        <DropShadowEffect x:Key="IconShadow" BlurRadius="8" Color="#000000" Opacity="0.24" ShadowDepth="2" Direction="270"/>
        <DropShadowEffect x:Key="BadgeShadow" BlurRadius="14" Color="#000000" Opacity="0.50" ShadowDepth="3" Direction="270"/>

        <!-- Base App Squircle Style -->
        <Style x:Key="SquircleContainer" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#32FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Vertical Etched Glass Divider Style -->
        <Style x:Key="DockGlassDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource DockDividerCenterBrush}"/>
            <Setter Property="OpacityMask">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical Compact Sub-Divider Style -->
        <Style x:Key="DockGlassSubDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource DockSubDividerCenterBrush}"/>
            <Setter Property="OpacityMask">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Taskbar-Style Dark Glass ContextMenu Styles -->
        <Style x:Key="DockGlassMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="FontFamily" Value="{StaticResource SFProDisplay}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="RowBg"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                Margin="1,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="GlyphText"
                                           Grid.Column="0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           Foreground="{TemplateBinding Foreground}"
                                           Margin="0,0,9,0"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DockGlassSeparator" TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#1FFFFFFF"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DockGlassContextMenu" TargetType="ContextMenu">
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DockGlassMenuItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Grid Margin="10,8,10,12">
                            <Border MinWidth="204"
                                    CornerRadius="12"
                                    Background="#EE141720"
                                    BorderBrush="#36FFFFFF"
                                    BorderThickness="1"
                                    Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Color="#000000" Opacity="0.5"/>
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="DockRootGrid" Height="136" VerticalAlignment="Bottom" HorizontalAlignment="Center"
          Background="Transparent"
          MouseMove="DockRootGrid_MouseMove" MouseLeave="DockRootGrid_MouseLeave">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="DockRootTranslate" X="0" Y="0"/>
        </Grid.RenderTransform>

        <!-- Sibling Shadow Layer (avoids nesting DropShadowEffect over ShaderEffect/BlurEffect) -->
        <Border x:Name="DockPillShadow"
                Width="{Binding ActualWidth, ElementName=DockPill}"
                Height="{Binding ActualHeight, ElementName=DockPill}"
                Margin="{Binding Margin, ElementName=DockPill}"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                CornerRadius="22"
                Background="#16000000"
                Effect="{StaticResource DockShadow}"
                IsHitTestVisible="False"/>

        <!-- Single-Rounded Floating Liquid Glass Dock Capsule (Padding=0 prevents nested pill artifact) -->
        <Border x:Name="DockPill"
                Height="64"
                VerticalAlignment="Bottom"
                CornerRadius="22"
                BorderThickness="0"
                Background="Transparent"
                Padding="0"
                Margin="14,0,14,10"
                MouseRightButtonUp="DockBackground_RightClick">
            <Grid>
                <!-- Live Liquid Glass Material Stack (wrapped in Canvas so capture image size never stretches DockPill) -->
                <Canvas IsHitTestVisible="False">
                    <Grid x:Name="DockGlassClipHost"
                          Width="{Binding ActualWidth, ElementName=DockPill}"
                          Height="{Binding ActualHeight, ElementName=DockPill}"
                          IsHitTestVisible="False"
                          SizeChanged="DockGlassClipHost_SizeChanged"
                          LayoutUpdated="DockGlassClipHost_LayoutUpdated">

                        <!-- Translucent Frosted Fallback Base (hidden once live Liquid Glass backdrop presents) -->
                        <Border x:Name="DockGlassFallbackFill"
                                CornerRadius="22"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#B8F6F8FC" Offset="0.0"/>
                                    <GradientStop Color="#A8EBF0F7" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Live Desktop Capture Host -->
                        <Border x:Name="DockGlassBackdropHost"
                                CornerRadius="22"
                                ClipToBounds="True"
                                Visibility="Visible"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Canvas>
                                <Image x:Name="DockGlassBackdropImage"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Stretch="Fill"
                                       Margin="0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Canvas>
                        </Border>

                        <!-- Clear Translucent Glass Veil (adaptive via ApplyDockAdaptiveGlassTheme) -->
                        <Border x:Name="DockGlassTintOverlay"
                                CornerRadius="22"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2EFFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#14FFFFFF" Offset="0.45"/>
                                    <GradientStop Color="#20FFFFFF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Subtle Micro-Noise Frost Grain -->
                        <Border x:Name="DockGlassGrainOverlay"
                                CornerRadius="22"
                                Opacity="0.035"
                                IsHitTestVisible="False"/>

                        <!-- Top Edge Soft Specular Sheen (borderless fill avoids any inner double-rounded line) -->
                        <Border CornerRadius="22"
                                BorderThickness="0"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#38FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#10FFFFFF" Offset="0.25"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.52"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Single Crisp Outer Refractive Rim -->
                        <Border x:Name="DockGlassRimBorder"
                                CornerRadius="22"
                                BorderThickness="1"
                                Margin="0"
                                IsHitTestVisible="False">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#D8FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#72FFFFFF" Offset="0.30"/>
                                    <GradientStop Color="#24000000" Offset="0.78"/>
                                    <GradientStop Color="#30000000" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                    </Grid>
                </Canvas>

                <!-- Horizontal Content: Launcher | Apps | Tray Chevron | Status Bar | Clock -->
                <StackPanel x:Name="DockContentPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,5">

                    <!-- 1. App Launcher (4-Dots Grid Icon) -->
                    <Grid x:Name="LauncherContainer" Width="44" Height="52" Cursor="Hand"
                          MouseLeftButtonDown="Launcher_Click"
                          MouseEnter="Launcher_MouseEnter"
                          MouseLeave="Launcher_MouseLeave">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="LauncherScale" ScaleX="1.0" ScaleY="1.0" CenterX="22" CenterY="22"/>
                                <TranslateTransform x:Name="LauncherTranslate" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border x:Name="LauncherSquircle" Style="{StaticResource SquircleContainer}" VerticalAlignment="Top" BorderBrush="{DynamicResource DockLauncherBorderBrush}" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#58FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#30FFFFFF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <UniformGrid Rows="2" Columns="2" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="6.5" Height="6.5" CornerRadius="2" Background="{DynamicResource DockLauncherDotBrush}" Margin="1.5"/>
                                <Border Width="6.5" Height="6.5" CornerRadius="2" Background="{DynamicResource DockLauncherDotBrush}" Margin="1.5"/>
                                <Border Width="6.5" Height="6.5" CornerRadius="2" Background="{DynamicResource DockLauncherDotBrush}" Margin="1.5"/>
                                <Border Width="6.5" Height="6.5" CornerRadius="2" Background="{DynamicResource DockLauncherDotBrush}" Margin="1.5"/>
                            </UniformGrid>
                        </Border>
                    </Grid>

                    <!-- Divider Left -->
                    <Border Style="{StaticResource DockGlassDivider}" Margin="10,0,7,0"/>

                    <!-- 2. Central Apps Panel (Handles Smooth Magnification Zoom) -->
                    <StackPanel x:Name="IconsPanel" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">

                        <!-- Item 1: Files / Explorer -->
                        <Grid x:Name="ItemExplorer" Width="44" Height="52" Margin="6,0" Cursor="Hand"
                              MouseLeftButtonDown="AppExplorer_Click" MouseRightButtonUp="PinnedApp_RightClick">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleExplorer" ScaleX="1.0" ScaleY="1.0" CenterX="22" CenterY="44"/>
                                    <TranslateTransform x:Name="TransExplorer" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Style="{StaticResource SquircleContainer}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFCA42" Offset="0.0"/>
                                        <GradientStop Color="#FFA705" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Width="22" Height="16" CornerRadius="4" BorderBrush="#FFFFFFFF" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Height="3" Background="#FFFFFFFF" VerticalAlignment="Top" Margin="2,1,2,0"/>
                                </Border>
                            </Border>
                            <Border x:Name="ActiveGlowExplorer" Style="{StaticResource SquircleContainer}" VerticalAlignment="Top" BorderBrush="#75FFFFFF" BorderThickness="1.2" Background="#16FFFFFF" IsHitTestVisible="False" Opacity="0"/>
                            <Border x:Name="IndicatorExplorer" Width="5" Height="5" CornerRadius="2.5" Background="#85FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1" Opacity="0"/>
                        </Grid>

                        <!-- Item 2: Browser / Web -->
                        <Grid x:Name="ItemBrowser" Width="44" Height="52" Margin="6,0" Cursor="Hand"
                              MouseLeftButtonDown="AppBrowser_Click" MouseRightButtonUp="PinnedApp_RightClick">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleBrowser" ScaleX="1.0" ScaleY="1.0" CenterX="22" CenterY="44"/>
                                    <TranslateTransform x:Name="TransBrowser" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Style="{StaticResource SquircleContainer}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3B8BFF" Offset="0.0"/>
                                        <GradientStop Color="#1867F5" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="21" Height="21" Stroke="#FFFFFFFF" StrokeThickness="2"/>
                                    <Rectangle Width="21" Height="2" Fill="#FFFFFFFF" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border x:Name="ActiveGlowBrowser" Style="{StaticResource SquircleContainer}" VerticalAlignment="Top" BorderBrush="#75FFFFFF" BorderThickness="1.2" Background="#16FFFFFF" IsHitTestVisible="False" Opacity="0"/>
                            <Border x:Name="IndicatorBrowser" Width="5" Height="5" CornerRadius="2.5" Background="#85FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1" Opacity="0"/>
                        </Grid>

                        <!-- Item 3: Messages / Chat -->
                        <Grid x:Name="ItemChat" Width="44" Height="52" Margin="6,0" Cursor="Hand"
                              MouseLeftButtonDown="AppChat_Click" MouseRightButtonUp="PinnedApp_RightClick">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleChat" ScaleX="1.0" ScaleY="1.0" CenterX="22" CenterY="44"/>
                                    <TranslateTransform x:Name="TransChat" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Style="{StaticResource SquircleContainer}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3DD569" Offset="0.0"/>
                                        <GradientStop Color="#22B14B" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Fill="#FFFFFFFF" Data="M 6,3 C 2.5,3 0,5.5 0,9 C 0,11.2 1.1,13.1 2.8,14.1 L 2.0,17.5 L 5.5,15.7 C 6.3,15.9 7.1,16 8,16 C 11.5,16 14,13.5 14,10 C 14,6.5 11.5,3 8,3 Z" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="19" Height="19"/>
                            </Border>
                            <Border x:Name="ActiveGlowChat" Style="{StaticResource SquircleContainer}" VerticalAlignment="Top" BorderBrush="#75FFFFFF" BorderThickness="1.2" Background="#16FFFFFF" IsHitTestVisible="False" Opacity="0"/>
                            <Border x:Name="IndicatorChat" Width="5" Height="5" CornerRadius="2.5" Background="#85FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1" Opacity="0"/>
                        </Grid>

                        <!-- Item 4: Music -->
                        <Grid x:Name="ItemMusic" Width="44" Height="52" Margin="6,0" Cursor="Hand"
                              MouseLeftButtonDown="AppMusic_Click" MouseRightButtonUp="PinnedApp_RightClick">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleMusic" ScaleX="1.0" ScaleY="1.0" CenterX="22" CenterY="44"/>
                                    <TranslateTransform x:Name="TransMusic" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Style="{StaticResource SquircleContainer}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#DF58E4" Offset="0.0"/>
                                        <GradientStop Color="#9B41E6" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Fill="#FFFFFFFF" Data="M 12,3 L 12,13 C 11.3,12.5 10.2,12.2 9,12.5 C 7.3,12.9 6.2,14.4 6.5,15.8 C 6.8,17.2 8.4,18 10.1,17.6 C 11.5,17.3 12.5,16.1 12.5,14.8 L 12.5,7 L 18,5.5 L 18,11.5 C 17.3,11 16.2,10.7 15,11 C 13.3,11.4 12.2,12.9 12.5,14.3 C 12.8,15.7 14.4,16.5 16.1,16.1 C 17.5,15.8 18.5,14.6 18.5,13.3 L 18.5,1.5 Z" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="19" Height="19"/>
                            </Border>
                            <Border x:Name="ActiveGlowMusic" Style="{StaticResource SquircleContainer}" VerticalAlignment="Top" BorderBrush="#75FFFFFF" BorderThickness="1.2" Background="#16FFFFFF" IsHitTestVisible="False" Opacity="0"/>
                            <Border x:Name="IndicatorMusic" Width="5" Height="5" CornerRadius="2.5" Background="#85FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1" Opacity="0"/>
                        </Grid>

                        <!-- Item 5: Notes -->
                        <Grid x:Name="ItemNotes" Width="44" Height="52" Margin="6,0" Cursor="Hand"
                              MouseLeftButtonDown="AppNotes_Click" MouseRightButtonUp="PinnedApp_RightClick">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleNotes" ScaleX="1.0" ScaleY="1.0" CenterX="22" CenterY="44"/>
                                    <TranslateTransform x:Name="TransNotes" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Style="{StaticResource SquircleContainer}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFD857" Offset="0.0"/>
                                        <GradientStop Color="#F6B828" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="21" Height="3" CornerRadius="1.5" Background="#7A5300" Margin="0,1.5"/>
                                    <Border Width="21" Height="3" CornerRadius="1.5" Background="#7A5300" Margin="0,1.5"/>
                                    <Border Width="21" Height="3" CornerRadius="1.5" Background="#7A5300" Margin="0,1.5"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ActiveGlowNotes" Style="{StaticResource SquircleContainer}" VerticalAlignment="Top" BorderBrush="#75FFFFFF" BorderThickness="1.2" Background="#16FFFFFF" IsHitTestVisible="False" Opacity="0"/>
                            <Border x:Name="IndicatorNotes" Width="5" Height="5" CornerRadius="2.5" Background="#85FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1" Opacity="0"/>
                        </Grid>

                        <!-- Item 6: Calendar -->
                        <Grid x:Name="ItemCalendar" Width="44" Height="52" Margin="6,0" Cursor="Hand"
                              MouseLeftButtonDown="AppCalendar_Click" MouseRightButtonUp="PinnedApp_RightClick">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleCalendar" ScaleX="1.0" ScaleY="1.0" CenterX="22" CenterY="44"/>
                                    <TranslateTransform x:Name="TransCalendar" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Style="{StaticResource SquircleContainer}" VerticalAlignment="Top" Background="#FFFFFFFF">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="13.5"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="11.5,11.5,0,0" Background="#FFE6392E">
                                        <TextBlock x:Name="CalendarMonthText" Text="NOV" FontSize="8" FontWeight="ExtraBold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="CalendarDayText" Grid.Row="1" Text="23" FontSize="17" FontWeight="Bold" Foreground="#FF1E1E24" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </Grid>
                            </Border>
                            <Border x:Name="ActiveGlowCalendar" Style="{StaticResource SquircleContainer}" VerticalAlignment="Top" BorderBrush="#75FFFFFF" BorderThickness="1.2" Background="#16FFFFFF" IsHitTestVisible="False" Opacity="0"/>
                            <Border x:Name="IndicatorCalendar" Width="5" Height="5" CornerRadius="2.5" Background="#85FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1" Opacity="0"/>
                        </Grid>

                        <!-- Item 7: Settings -->
                        <Grid x:Name="ItemSettings" Width="44" Height="52" Margin="6,0" Cursor="Hand"
                              MouseLeftButtonDown="AppSettings_Click" MouseRightButtonUp="PinnedApp_RightClick">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleSettings" ScaleX="1.0" ScaleY="1.0" CenterX="22" CenterY="44"/>
                                    <TranslateTransform x:Name="TransSettings" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Style="{StaticResource SquircleContainer}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#6E7580" Offset="0.0"/>
                                        <GradientStop Color="#494E57" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Fill="#FFFFFFFF" Data="M 12,8 A 4,4 0 1,0 12,16 A 4,4 0 1,0 12,8 Z M 11,1 L 13,1 L 13,4 L 11,4 Z M 11,20 L 13,20 L 13,23 L 11,23 Z M 1,11 L 4,11 L 4,13 L 1,13 Z M 20,11 L 23,11 L 23,13 L 20,13 Z M 4.2,4.2 L 6.3,4.2 L 6.3,6.3 L 4.2,6.3 Z M 17.7,17.7 L 19.8,17.7 L 19.8,19.8 L 17.7,19.8 Z M 17.7,4.2 L 19.8,4.2 L 19.8,6.3 L 17.7,6.3 Z M 4.2,17.7 L 6.3,17.7 L 6.3,19.8 L 4.2,19.8 Z" Stretch="Uniform" Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="ActiveGlowSettings" Style="{StaticResource SquircleContainer}" VerticalAlignment="Top" BorderBrush="#75FFFFFF" BorderThickness="1.2" Background="#16FFFFFF" IsHitTestVisible="False" Opacity="0"/>
                            <Border x:Name="IndicatorSettings" Width="5" Height="5" CornerRadius="2.5" Background="#85FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1" Opacity="0"/>
                        </Grid>

                        <!-- Dynamic Running Apps Divider (visible only when unpinned apps are running) -->
                        <Border x:Name="RunningAppsDivider" Style="{StaticResource DockGlassDivider}" Margin="5,0" Visibility="Collapsed"/>

                        <!-- Dynamic Running Apps Container -->
                        <StackPanel x:Name="RunningAppsPanel" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent"/>

                    </StackPanel>

                    <!-- Divider Right -->
                    <Border Style="{StaticResource DockGlassDivider}" Margin="7,0,8,0"/>

                    <!-- 3. System Tray Chevron Button (Taskbar Overflow Flyout) -->
                    <Border x:Name="SystemTrayButton"
                            Width="28"
                            Height="36"
                            CornerRadius="9"
                            Background="Transparent"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Margin="0,0,2,0"
                            MouseLeftButtonDown="SystemTrayButton_Click"
                            ToolTip="System Tray (Ikon Tersembunyi &amp; Klik Kanan)">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DockWidgetHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="SystemTrayChevron"
                                   Text="&#xE70E;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource DockIconForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="SystemTrayChevronRotate" Angle="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>

                    <!-- Sub-Divider -->
                    <Border Style="{StaticResource DockGlassSubDivider}"/>

                    <!-- 4. System Status Bar Capsule (Internet Speed | Battery | Volume) -->
                    <StackPanel x:Name="StatusBarPanel" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Internet Speed Widget -->
                        <Border x:Name="NetSpeedWidget"
                                Width="78"
                                Height="36"
                                CornerRadius="9"
                                Padding="4,4"
                                Background="Transparent"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="2,0"
                                MouseLeftButtonDown="NetSpeedWidget_Click"
                                ToolTip="Kecepatan Internet Real-Time (Klik untuk Pengaturan Jaringan)">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DockWidgetHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="↓"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource DockNetArrowBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,-1,3,0"/>
                                <TextBlock x:Name="NetSpeedDownText"
                                           Width="56"
                                           Text="0 B/s"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource DockPrimaryForegroundBrush}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Sub-Divider -->
                        <Border Style="{StaticResource DockGlassSubDivider}"/>

                        <!-- Battery Status Widget -->
                        <Border x:Name="BatteryWidget"
                                Width="66"
                                Height="36"
                                CornerRadius="9"
                                Padding="4,4"
                                Background="Transparent"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="2,0"
                                MouseLeftButtonDown="BatteryWidget_Click"
                                ToolTip="Status Baterai (Klik untuk Pengaturan Daya)">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DockWidgetHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid VerticalAlignment="Center" Margin="0,0,4,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="2"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            x:Name="BatteryFrame"
                                            Width="20" Height="11"
                                            CornerRadius="2.5"
                                            BorderThickness="1.2"
                                            BorderBrush="{DynamicResource DockIconForegroundBrush}"
                                            HorizontalAlignment="Left">
                                        <Grid>
                                            <Border x:Name="BatteryFill"
                                                    Width="14"
                                                    Height="7"
                                                    CornerRadius="1.2"
                                                    Background="{DynamicResource DockPrimaryForegroundBrush}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Margin="1,0,0,0"/>

                                            <Path x:Name="BatteryChargingBolt"
                                                  Data="M 6 0 L 1.5 5.5 L 4.5 5.5 L 3.5 10 L 8.5 4 L 5.5 4 Z"
                                                  Fill="#FFFFFFFF"
                                                  Stroke="#FF0B0E14"
                                                  StrokeThickness="0.6"
                                                  Stretch="Uniform"
                                                  Width="6.5" Height="8"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1"
                                            x:Name="BatteryNub"
                                            Width="2" Height="5"
                                            CornerRadius="0,1,1,0"
                                            Background="{DynamicResource DockIconForegroundBrush}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="-0.2,0,0,0"/>
                                </Grid>

                                <TextBlock x:Name="BatteryPercentText"
                                           Width="31"
                                           Text="100%"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource DockPrimaryForegroundBrush}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Sub-Divider -->
                        <Border Style="{StaticResource DockGlassSubDivider}"/>

                        <!-- Master Volume Widget -->
                        <Border x:Name="VolumeWidget"
                                Width="64"
                                Height="36"
                                CornerRadius="9"
                                Padding="4,4"
                                Background="Transparent"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="2,0"
                                MouseLeftButtonDown="VolumeWidget_Click"
                                MouseWheel="VolumeWidget_MouseWheel"
                                ToolTip="Volume Master&#x0a;• Klik untuk Mute / Unmute&#x0a;• Scroll mouse untuk atur volume">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DockWidgetHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="VolumeIcon"
                                           Text="&#xE995;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource DockIconForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                                <TextBlock x:Name="VolumePercentText"
                                           Width="34"
                                           Text="50%"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource DockPrimaryForegroundBrush}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Left"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- Divider Right before Clock -->
                    <Border Style="{StaticResource DockGlassDivider}" Margin="6,0,6,0"/>

                    <!-- 5. Live Digital Clock & Date Widget -->
                    <Border x:Name="ClockWidgetBorder"
                            CornerRadius="9"
                            Padding="7,4"
                            Background="Transparent"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Margin="0,0,2,0"
                            MouseLeftButtonDown="Clock_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DockWidgetHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel x:Name="ClockWidget" VerticalAlignment="Center">
                            <TextBlock x:Name="ClockTimeText"
                                       Text="13:15"
                                       FontWeight="SemiBold"
                                       FontSize="13.5"
                                       Foreground="{DynamicResource DockPrimaryForegroundBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ClockDateText"
                                       Text="23/11/2026"
                                       FontSize="9.5"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource DockSecondaryForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Floating Tooltip Badge -->
        <Border x:Name="TooltipBadge"
                Panel.ZIndex="999"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="8"
                Background="#EE141720"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                Padding="11,4"
                Opacity="0"
                IsHitTestVisible="False"
                Effect="{StaticResource BadgeShadow}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="TooltipTranslate" X="0" Y="0"/>
            </Border.RenderTransform>
            <TextBlock x:Name="TooltipText"
                       Text="Musik"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="#F5FFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
