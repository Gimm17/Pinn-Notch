<Window x:Class="VNotch.Windows.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pinn-Dock"
        Height="115"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Width"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Soft Drop Shadow for the Floating Dock -->
        <DropShadowEffect x:Key="DockShadow" BlurRadius="32" Color="#000000" Opacity="0.28" ShadowDepth="4" Direction="270"/>
        <DropShadowEffect x:Key="IconShadow" BlurRadius="8" Color="#000000" Opacity="0.18" ShadowDepth="2" Direction="270"/>
        <DropShadowEffect x:Key="BadgeShadow" BlurRadius="12" Color="#000000" Opacity="0.45" ShadowDepth="2" Direction="270"/>

        <!-- Base Squircle Style -->
        <Style x:Key="SquircleContainer" TargetType="Border">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource IconShadow}"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="DockRootGrid" Height="115" VerticalAlignment="Bottom" HorizontalAlignment="Center">
        <!-- Floating Tooltip Badge (Positioned dynamically above hovered icon) -->
        <Border x:Name="TooltipBadge"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,8,0,0"
                CornerRadius="9"
                Background="#EE202026"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                Padding="12,3"
                Opacity="0"
                IsHitTestVisible="False"
                Effect="{StaticResource BadgeShadow}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="TooltipTranslate" X="0" Y="0"/>
            </Border.RenderTransform>
            <TextBlock x:Name="TooltipText"
                       Text="Musik"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Main Dock Glass Pill (Milky Frosted Glass - Reference Image 1 & 2) -->
        <Border x:Name="DockPill"
                Height="66"
                VerticalAlignment="Bottom"
                CornerRadius="25"
                BorderBrush="#60FFFFFF"
                BorderThickness="1.5"
                Effect="{StaticResource DockShadow}"
                Padding="12,6"
                Margin="12,0,12,12">
            <!-- Frosted Glass Background -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F4FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#E4F6F6FC" Offset="0.4"/>
                    <GradientStop Color="#CCEAEAF4" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <!-- Inner Subtle Specular Rim -->
            <Grid>
                <Border CornerRadius="24" BorderBrush="#35FFFFFF" BorderThickness="1" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#25FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.35"/>
                            <GradientStop Color="#05000000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Horizontal Content: Launcher | Apps | Clock -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- 1. App Launcher (4-Dots Grid Icon) -->
                    <Grid x:Name="LauncherContainer" Width="46" Height="54" Cursor="Hand" MouseLeftButtonDown="Launcher_Click" MouseEnter="Launcher_MouseEnter" MouseLeave="Launcher_MouseLeave">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="LauncherScale" ScaleX="1.0" ScaleY="1.0" CenterX="23" CenterY="23"/>
                                <TranslateTransform x:Name="LauncherTranslate" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border Style="{StaticResource SquircleContainer}" VerticalAlignment="Top" Background="#FF7D7784" BorderBrush="#35FFFFFF" BorderThickness="1">
                            <!-- 2x2 Grid Dots -->
                            <UniformGrid Rows="2" Columns="2" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="7" Height="7" CornerRadius="2.5" Background="#FFFFFFFF" Margin="1.5"/>
                                <Border Width="7" Height="7" CornerRadius="2.5" Background="#FFFFFFFF" Margin="1.5"/>
                                <Border Width="7" Height="7" CornerRadius="2.5" Background="#FFFFFFFF" Margin="1.5"/>
                                <Border Width="7" Height="7" CornerRadius="2.5" Background="#FFFFFFFF" Margin="1.5"/>
                            </UniformGrid>
                        </Border>
                    </Grid>

                    <!-- Divider Left -->
                    <Border Width="1" Height="26" Background="#28000000" Margin="10,0,10,0" VerticalAlignment="Center"/>

                    <!-- 2. Central Apps Panel (Handles Smooth Magnification Zoom) -->
                    <StackPanel x:Name="IconsPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                MouseMove="IconsPanel_MouseMove" MouseLeave="IconsPanel_MouseLeave">

                        <!-- Item 1: Files / Explorer (Yellow Squircle) -->
                        <Grid x:Name="ItemExplorer" Width="46" Height="54" Margin="3,0" Cursor="Hand" MouseLeftButtonDown="AppExplorer_Click">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleExplorer" ScaleX="1.0" ScaleY="1.0" CenterX="23" CenterY="46"/>
                                    <TranslateTransform x:Name="TransExplorer" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Style="{StaticResource SquircleContainer}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFCA42" Offset="0.0"/>
                                        <GradientStop Color="#FFA705" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <!-- Window/Folder Frame Icon -->
                                <Border Width="24" Height="17" CornerRadius="4" BorderBrush="#FFFFFFFF" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Height="3" Background="#FFFFFFFF" VerticalAlignment="Top" Margin="2,1,2,0"/>
                                </Border>
                            </Border>
                            <!-- Running Indicator Dot -->
                            <Ellipse x:Name="DotExplorer" Width="4" Height="4" Fill="#FF44444C" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        </Grid>

                        <!-- Item 2: Browser / Web (Blue Squircle) -->
                        <Grid x:Name="ItemBrowser" Width="46" Height="54" Margin="3,0" Cursor="Hand" MouseLeftButtonDown="AppBrowser_Click">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleBrowser" ScaleX="1.0" ScaleY="1.0" CenterX="23" CenterY="46"/>
                                    <TranslateTransform x:Name="TransBrowser" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Style="{StaticResource SquircleContainer}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3B8BFF" Offset="0.0"/>
                                        <GradientStop Color="#1867F5" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <!-- Globe/Compass Icon -->
                                <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="22" Height="22" Stroke="#FFFFFFFF" StrokeThickness="2"/>
                                    <Rectangle Width="22" Height="2" Fill="#FFFFFFFF" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Ellipse x:Name="DotBrowser" Width="4" Height="4" Fill="#FF44444C" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        </Grid>

                        <!-- Item 3: Messages / Chat (Green Squircle) -->
                        <Grid x:Name="ItemChat" Width="46" Height="54" Margin="3,0" Cursor="Hand" MouseLeftButtonDown="AppChat_Click">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleChat" ScaleX="1.0" ScaleY="1.0" CenterX="23" CenterY="46"/>
                                    <TranslateTransform x:Name="TransChat" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Style="{StaticResource SquircleContainer}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3DD569" Offset="0.0"/>
                                        <GradientStop Color="#22B14B" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <!-- Speech Bubble Icon -->
                                <Path Fill="#FFFFFFFF" Data="M 6,3 C 2.5,3 0,5.5 0,9 C 0,11.2 1.1,13.1 2.8,14.1 L 2.0,17.5 L 5.5,15.7 C 6.3,15.9 7.1,16 8,16 C 11.5,16 14,13.5 14,10 C 14,6.5 11.5,3 8,3 Z" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="20" Height="20"/>
                            </Border>
                            <Ellipse x:Name="DotChat" Width="4" Height="4" Fill="#FF44444C" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        </Grid>

                        <!-- Item 4: Music (Magenta/Purple Squircle) -->
                        <Grid x:Name="ItemMusic" Width="46" Height="54" Margin="3,0" Cursor="Hand" MouseLeftButtonDown="AppMusic_Click">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleMusic" ScaleX="1.0" ScaleY="1.0" CenterX="23" CenterY="46"/>
                                    <TranslateTransform x:Name="TransMusic" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Style="{StaticResource SquircleContainer}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#DF58E4" Offset="0.0"/>
                                        <GradientStop Color="#9B41E6" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <!-- Musical Note Beamed Icon -->
                                <Path Fill="#FFFFFFFF" Data="M 12,3 L 12,13 C 11.3,12.5 10.2,12.2 9,12.5 C 7.3,12.9 6.2,14.4 6.5,15.8 C 6.8,17.2 8.4,18 10.1,17.6 C 11.5,17.3 12.5,16.1 12.5,14.8 L 12.5,7 L 18,5.5 L 18,11.5 C 17.3,11 16.2,10.7 15,11 C 13.3,11.4 12.2,12.9 12.5,14.3 C 12.8,15.7 14.4,16.5 16.1,16.1 C 17.5,15.8 18.5,14.6 18.5,13.3 L 18.5,1.5 Z" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="20" Height="20"/>
                            </Border>
                            <Ellipse x:Name="DotMusic" Width="4" Height="4" Fill="#FF44444C" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        </Grid>

                        <!-- Item 5: Notes (Yellow/Amber Squircle) -->
                        <Grid x:Name="ItemNotes" Width="46" Height="54" Margin="3,0" Cursor="Hand" MouseLeftButtonDown="AppNotes_Click">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleNotes" ScaleX="1.0" ScaleY="1.0" CenterX="23" CenterY="46"/>
                                    <TranslateTransform x:Name="TransNotes" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Style="{StaticResource SquircleContainer}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFD857" Offset="0.0"/>
                                        <GradientStop Color="#F6B828" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <!-- 3 Horizontal List Bars -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="22" Height="3.2" CornerRadius="1.6" Background="#7A5300" Margin="0,1.5"/>
                                    <Border Width="22" Height="3.2" CornerRadius="1.6" Background="#7A5300" Margin="0,1.5"/>
                                    <Border Width="22" Height="3.2" CornerRadius="1.6" Background="#7A5300" Margin="0,1.5"/>
                                </StackPanel>
                            </Border>
                            <Ellipse x:Name="DotNotes" Width="4" Height="4" Fill="#FF44444C" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        </Grid>

                        <!-- Item 6: Calendar (White Card with Red Header) -->
                        <Grid x:Name="ItemCalendar" Width="46" Height="54" Margin="3,0" Cursor="Hand" MouseLeftButtonDown="AppCalendar_Click">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleCalendar" ScaleX="1.0" ScaleY="1.0" CenterX="23" CenterY="46"/>
                                    <TranslateTransform x:Name="TransCalendar" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Style="{StaticResource SquircleContainer}" VerticalAlignment="Top" Background="#FFFFFFFF">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- Red Header with Month -->
                                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="#FFE6392E">
                                        <TextBlock x:Name="CalendarMonthText" Text="OKT" FontSize="8.5" FontWeight="ExtraBold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Date Number -->
                                    <TextBlock x:Name="CalendarDayText" Grid.Row="1" Text="27" FontSize="18" FontWeight="Bold" Foreground="#FF1E1E24" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </Grid>
                            </Border>
                            <Ellipse x:Name="DotCalendar" Width="4" Height="4" Fill="#FF44444C" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        </Grid>

                        <!-- Item 7: Settings (Dark Slate Gear Squircle) -->
                        <Grid x:Name="ItemSettings" Width="46" Height="54" Margin="3,0" Cursor="Hand" MouseLeftButtonDown="AppSettings_Click">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleSettings" ScaleX="1.0" ScaleY="1.0" CenterX="23" CenterY="46"/>
                                    <TranslateTransform x:Name="TransSettings" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Style="{StaticResource SquircleContainer}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#62686F" Offset="0.0"/>
                                        <GradientStop Color="#464B51" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <!-- Radiating Gear/Dial Icon -->
                                <Path Fill="#FFFFFFFF" Data="M 12,8 A 4,4 0 1,0 12,16 A 4,4 0 1,0 12,8 Z M 11,1 L 13,1 L 13,4 L 11,4 Z M 11,20 L 13,20 L 13,23 L 11,23 Z M 1,11 L 4,11 L 4,13 L 1,13 Z M 20,11 L 23,11 L 23,13 L 20,13 Z M 4.2,4.2 L 6.3,4.2 L 6.3,6.3 L 4.2,6.3 Z M 17.7,17.7 L 19.8,17.7 L 19.8,19.8 L 17.7,19.8 Z M 17.7,4.2 L 19.8,4.2 L 19.8,6.3 L 17.7,6.3 Z M 4.2,17.7 L 6.3,17.7 L 6.3,19.8 L 4.2,19.8 Z" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Ellipse x:Name="DotSettings" Width="4" Height="4" Fill="#FF44444C" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        </Grid>

                    </StackPanel>

                    <!-- Divider Right -->
                    <Border Width="1" Height="26" Background="#28000000" Margin="10,0,12,0" VerticalAlignment="Center"/>

                    <!-- 3. Live Digital Clock & Date Widget (Dark Text for Contrast) -->
                    <StackPanel x:Name="ClockWidget" VerticalAlignment="Center" Margin="2,0,8,0" Cursor="Hand" MouseLeftButtonDown="Clock_Click">
                        <TextBlock x:Name="ClockTimeText"
                                   Text="13:15"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#FF1A1A22"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ClockDateText"
                                   Text="27/10/2026"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="#991A1A22"
                                   HorizontalAlignment="Center"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
