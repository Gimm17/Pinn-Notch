<UserControl x:Class="VNotch.Controls.NotesWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:VNotch.Controls"
             xmlns:svc="clr-namespace:VNotch.Services"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style x:Key="SegmentBtnStyle" TargetType="Border">
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="WidgetBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="{x:Static svc:UiPalette.PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Width="640" Height="220"
            CornerRadius="16"
            Padding="16,12"
            BorderBrush="{DynamicResource NotchBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource CardGradient}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Segmented Tab Controls -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mode Selector -->
                <Border Grid.Column="0"
                        Background="#14FFFFFF"
                        CornerRadius="14"
                        Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="NotesTabBtn"
                                Style="{StaticResource SegmentBtnStyle}"
                                Background="#33FFFFFF"
                                MouseLeftButtonDown="NotesTabBtn_Click">
                            <TextBlock x:Name="NotesTabText"
                                       Text="📝 Quick Notes"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Static svc:UiPalette.PrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border x:Name="TodoTabBtn"
                                Style="{StaticResource SegmentBtnStyle}"
                                Margin="4,0,0,0"
                                MouseLeftButtonDown="TodoTabBtn_Click">
                            <TextBlock x:Name="TodoTabText"
                                       Text="✅ To-Do Checklist"
                                       FontSize="12"
                                       FontWeight="Normal"
                                       Foreground="{x:Static svc:UiPalette.SecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CopyBtn"
                            Style="{StaticResource WidgetBtnStyle}"
                            Content="📋 Copy"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Click="CopyBtn_Click"/>

                    <Button x:Name="ClearBtn"
                            Style="{StaticResource WidgetBtnStyle}"
                            Content="🗑️ Clear"
                            FontSize="11"
                            Click="ClearBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- Mode 1: Quick Notes Text Editor -->
            <Grid x:Name="NotesPanel" Grid.Row="1" Visibility="Visible">
                <Border Background="#12FFFFFF"
                        CornerRadius="10"
                        Padding="10,8">
                    <Grid>
                        <TextBox x:Name="NotesTextBox"
                                 Background="Transparent"
                                 Foreground="{x:Static svc:UiPalette.PrimaryBrush}"
                                 CaretBrush="{x:Static svc:UiPalette.PrimaryBrush}"
                                 BorderThickness="0"
                                 FontSize="13"
                                 FontFamily="Segoe UI"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="NotesTextBox_TextChanged"/>

                        <TextBlock x:Name="NotesPlaceholder"
                                   Text="Type your quick thoughts, reminders, or scratchpad here..."
                                   Foreground="#55FFFFFF"
                                   FontSize="13"
                                   IsHitTestVisible="False"
                                   Margin="3,2,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Mode 2: To-Do Checklist -->
            <Grid x:Name="TodoPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Add Task Row -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#14FFFFFF"
                            CornerRadius="8"
                            Padding="8,4"
                            Margin="0,0,8,0">
                        <Grid>
                            <TextBox x:Name="NewTaskBox"
                                     Background="Transparent"
                                     Foreground="{x:Static svc:UiPalette.PrimaryBrush}"
                                     CaretBrush="{x:Static svc:UiPalette.PrimaryBrush}"
                                     BorderThickness="0"
                                     FontSize="12"
                                     KeyDown="NewTaskBox_KeyDown"/>

                            <TextBlock x:Name="TaskPlaceholder"
                                       Text="Add a new task (Press Enter)..."
                                       Foreground="#55FFFFFF"
                                       FontSize="12"
                                       IsHitTestVisible="False"
                                       Margin="2,1,0,0"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1"
                            Style="{StaticResource WidgetBtnStyle}"
                            Content="+ Add"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Click="AddTask_Click"/>
                </Grid>

                <!-- Tasks Scrollable List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TasksListStackPanel"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
